#!/bin/bash
# Dispatch to fake-suspend or real suspend per ARMADA_SUSPEND_MODE.
set -uo pipefail

device_env=${ARMADA_DEVICE_ENV:-/usr/libexec/armada/device-env}
fake_suspend=${ARMADA_FAKE_SUSPEND:-/usr/libexec/armada/fake-suspend}
eval "$("$device_env" 2>/dev/null)" || true
mode="${ARMADA_SUSPEND_MODE:-fake}"

if [[ "$mode" == "fake" ]]; then
    exec "$fake_suspend" sleep
fi

if [[ "$mode" == "s2idle" || "$mode" == "deep" ]]; then
    mem_sleep=${ARMADA_MEM_SLEEP_PATH:-/sys/power/mem_sleep}
    if [[ ! -w "$mem_sleep" ]] ||
        ! grep -qw "$mode" "$mem_sleep"; then
        echo "suspend-dispatch: unsupported sleep mode $mode; using fake suspend" >&2
        exec "$fake_suspend" sleep
    fi
    if ! echo "$mode" >"$mem_sleep"; then
        echo "suspend-dispatch: failed to select sleep mode $mode; using fake suspend" >&2
        exec "$fake_suspend" sleep
    fi
elif [[ "$mode" != "mem" ]]; then
    echo "suspend-dispatch: invalid sleep mode $mode; using fake suspend" >&2
    exec "$fake_suspend" sleep
fi

# Real suspend: prefer systemd-sleep so its sleep hooks and process freeze run.
sleep_bin=""
if [[ -n "${ARMADA_SYSTEMD_SLEEP:-}" ]]; then
    sleep_bin="$ARMADA_SYSTEMD_SLEEP"
else
    for b in /usr/lib/systemd/systemd-sleep /lib/systemd/systemd-sleep; do
        [[ -x "$b" ]] && { sleep_bin="$b"; break; }
    done
fi

# --- Spurious-wake re-suspend guard ---------------------------------------
# One unplanned wake (ADSP battery notice over glink/ipcc, ucsi churn, thermal
# IRQ…) otherwise leaves the device fully awake with the screen off at
# idle-awake power for hours — measured ~5 W on Odin 2 (armada#265/#274:
# "right side stays warm"). If the resume was not user-initiated and the
# charger state did not change, go back to sleep. Bounded and logged; set
# ARMADA_RESUSPEND_MAX=0 to disable.
#
# Wake classification is by the IDENTITY of the IRQ that woke us
# (/sys/power/pm_wakeup_irq resolved against /proc/interrupts), not by
# accumulated input-IRQ counts: on Odin 2 the gamepad MCU floods its UART
# with hundreds of interrupts during every resume — measured +200..+600
# input IRQs even for RTC wakes nobody caused — so counting cannot tell a
# user wake from a spurious one. Counts remain only as the fallback when
# the wake IRQ cannot be resolved.
user_irq_sum() {
    # Total interrupt count across IRQs whose names look like user input
    # (power key, lid/gpio keys, touchscreens, gamepad MCU on its UART link).
    awk -F: '$0 ~ /pwrkey|pmic_resin|gpio-keys|[Ll]id|rsinput|Gamepad|[Pp]addle|ft5x06|ft5452|Goodix|hynitron|synaptics|dsx|cstxxx|geni_serial_uart/ {
        n = split($2, c, " ")
        for (i = 1; i <= n && c[i] ~ /^[0-9]+$/; i++) s += c[i]
    } END { print s + 0 }' /proc/interrupts
}

button_irq_sum() {
    # Like user_irq_sum but EXCLUDES the gamepad MCU UART: that link floods
    # for seconds after every resume (measured +200..+600 IRQs on RTC wakes
    # nobody caused), so counting it during a 2 s backoff misreads the tail
    # of the flood as a button press and aborts the re-suspend. Physical
    # keys and touchscreens do not flood; a power-button press during the
    # backoff still shows up here. A gamepad press during the backoff is
    # not caught, but it does not wake a suspended device either — the
    # user presses power next and the wake classifier sees pwrkey.
    awk -F: '$0 ~ /pwrkey|pmic_resin|gpio-keys|[Ll]id|[Pp]addle|ft5x06|ft5452|Goodix|hynitron|synaptics|dsx|cstxxx/ && $0 !~ /geni_serial_uart/ {
        n = split($2, c, " ")
        for (i = 1; i <= n && c[i] ~ /^[0-9]+$/; i++) s += c[i]
    } END { print s + 0 }' /proc/interrupts
}

wake_irq_name() {
    # Resolve a wake IRQ number to its name from /proc/interrupts.
    local irq="${1:-}"
    [[ -n "$irq" ]] || { echo ""; return; }
    awk -v want="$irq:" '$1 == want { print $NF; exit }' /proc/interrupts
}

is_user_wake_irq() {
    # Does this IRQ name belong to a user-input device? (power/volume keys,
    # gpio keys, lid, touch digitizers, gamepad MCU — on armada handhelds the
    # gamepad rides a geni UART, so a UART wake is a button press. A BT
    # controller wake is also user intent.)
    local name
    name="$(wake_irq_name "$1")"
    [[ -n "$name" ]] || return 2
    grep -Eqi 'pwrkey|resin|gpio.?keys|keypad|lid|rsinput|gamepad|paddle|ft5|goodix|hynitron|synaptics|cst[0-9]|touch|uart' <<<"$name"
}

usb_online() {
    local u
    for u in /sys/class/power_supply/*usb*/online /sys/class/power_supply/*USB*/online; do
        [[ -r "$u" ]] && { cat "$u" 2>/dev/null; return; }
    done
    echo 0
}

run_real_suspend() {
    # Default 60: ADSP battery notices arrive every ~25-40 min, so a 5-deep
    # cap gave up after ~2-3 h and the device sat awake for the rest of the
    # night; a genuine user wake exits on the first resume, so the cap only
    # bounds true wake storms.
    local max=${ARMADA_RESUSPEND_MAX:-60} n=0 delay=2
    local pre_user pre_usb post_user post_usb pre_btn post_btn wake_irq wake_name verdict
    while :; do
        pre_user=$(user_irq_sum); pre_btn=$(button_irq_sum)
        pre_usb=$(usb_online)
        "$sleep_bin" suspend "$@"
        post_user=$(user_irq_sum); post_btn=$(button_irq_sum)
        post_usb=$(usb_online)
        wake_irq="$(cat /sys/power/pm_wakeup_irq 2>/dev/null || true)"
        wake_name="$(wake_irq_name "$wake_irq")"

        if [[ "$post_usb" != "$pre_usb" ]]; then
            logger -t suspend-dispatch -- \
                "charger event during suspend (usb online $pre_usb->$post_usb); staying awake"
            return 0
        fi

        verdict=""
        if [[ -n "$wake_irq" ]]; then
            if is_user_wake_irq "$wake_irq"; then
                verdict=user
            elif [[ -n "$wake_name" ]]; then
                verdict=spurious
            fi
        fi
        if [[ -z "$verdict" ]]; then
            # Wake IRQ unattributed: fall back to button counts (flood-safe).
            if (( post_btn > pre_btn )); then verdict=user; else verdict=spurious; fi
        fi

        if [[ "$verdict" == "user" ]]; then
            logger -t suspend-dispatch -- \
                "user wake (wake irq ${wake_irq:-?} ${wake_name:-unattributed}, input irqs +$((post_user - pre_user)))"
            return 0
        fi
        if (( ++n > max )); then
            logger -t suspend-dispatch -- \
                "no user wake but staying up after $max spurious resumes (last wake irq ${wake_irq:-unknown} ${wake_name:-unknown})"
            return 0
        fi
        sleep "$delay"
        # A button pressed during the backoff must not be swallowed. Count
        # only physical keys/touch: the gamepad UART is still draining its
        # resume flood here and would false-positive every time.
        if (( $(button_irq_sum) > post_btn )); then
            logger -t suspend-dispatch -- "user input during backoff; staying awake"
            return 0
        fi
        logger -t suspend-dispatch -- \
            "spurious wake (irq ${wake_irq:-unknown} ${wake_name:-unknown}); re-suspending $n/$max"
    done
}

if [[ -n "$sleep_bin" ]]; then
    run_real_suspend
else
    # No systemd-sleep found: write the state directly rather than leave sleep dead.
    echo mem > /sys/power/state
fi
