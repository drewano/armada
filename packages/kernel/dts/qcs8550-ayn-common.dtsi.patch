From: Armada <noreply@armada.local>
Subject: [PATCH] arm64: dts: qcom: qcs8550-ayn: SDHCI caps, rumble, PCIe WAKE polarity, rpmh sleep-vote rails

Arm rpmh regulator-state-mem for the deep-suspend stack: vreg_bob2 off in
suspend (gamepad/RGB rail), vreg_l15b_1p8 on in LPM (UFS/PHY IO rail).
The 0560/0561 kernel patches only act on rails whose DT carries
regulator-state-mem, so these nodes are what arms the SLEEP/WAKE TCS
votes. The vdd_mcu_3v3 fixed-regulator state-mem hunk from the first
port is dropped: fixed_voltage_ops has no suspend ops in mainline, so it
was a silent no-op (the real MCU quiesce is the rsinput suspend patch).

diff --git a/arch/arm64/boot/dts/qcom/qcs8550-ayn-common.dtsi b/arch/arm64/boot/dts/qcom/qcs8550-ayn-common.dtsi
index 156dff3..6462b12 100644
--- a/arch/arm64/boot/dts/qcom/qcs8550-ayn-common.dtsi
+++ b/arch/arm64/boot/dts/qcom/qcs8550-ayn-common.dtsi
@@ -51,7 +51,6 @@
 			gpios = <&pm8550_gpios 6 GPIO_ACTIVE_LOW>;
 			linux,code = <KEY_VOLUMEUP>;
 			linux,can-disable;
-			wakeup-source;
 		};
 	};
 
@@ -598,6 +597,10 @@
 			regulator-min-microvolt = <2720000>;
 			regulator-max-microvolt = <3960000>;
 			regulator-initial-mode = <RPMH_REGULATOR_MODE_HPM>;
+
+			regulator-state-mem {
+				regulator-off-in-suspend;
+			};
 		};
 
 		vreg_l2b_3p0: ldo2 {
@@ -705,6 +708,11 @@
 			regulator-allow-set-load;
 			regulator-allowed-modes = <RPMH_REGULATOR_MODE_LPM
 						   RPMH_REGULATOR_MODE_HPM>;
+
+			regulator-state-mem {
+				regulator-on-in-suspend;
+				regulator-mode = <RPMH_REGULATOR_MODE_LPM>;
+			};
 		};
 
 		vreg_l16b_2p8: ldo16 {
@@ -1096,7 +1104,7 @@
 };
 
 &pcieport0 {
-	wake-gpios = <&tlmm 96 GPIO_ACTIVE_HIGH>;
+	wake-gpios = <&tlmm 96 GPIO_ACTIVE_LOW>;
 	reset-gpios = <&tlmm 94 GPIO_ACTIVE_LOW>;
 
 	wifi@0 {
@@ -1462,7 +1470,6 @@
 	no-mmc;
 
 	qcom,dll-config = <0x0007442c>;
-	sdhci-caps-mask = <0x3 0x0>;
 
 	status = "okay";
 };
@@ -1700,6 +1707,7 @@
 
 	gamepad: gamepad {
 		compatible = "gamepad,rsinput";
+		rumble-haptics;
 
 		gamepad-name = "AYN Odin2 Gamepad";
 		gamepad-bus = <0x0003>;
